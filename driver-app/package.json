{
  "name": "golapi-driver",
  "private": true,
  "version": "2.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:web": "vite build --base=/driver/",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
